588\" height=\"330\">\n                  <img class=\"fr-responsive-img\" src=\"https://www.anact.fr/sites/default/files/styles/one_image_fallback/public/2024-02/tableau-CPR.jpg?itok=G3Qapxjj\" alt=\"24-aract-aura-CPR\">\n\n  </picture>\n\n      </div>\n          </figure>\n  \n          </div>\n                  </div>\n      </div>\n    </div>\n  </div>\n</dialog>\n\n\n      \n    </div>\n  </div>\n\n\n</div>\n\n  No","sourceUrl":"https://www.anact.fr/decouvrez-le-comite-paritaire-regional-de-laract-aura","pillar":{"id":"D","label":"GAPP","targetPage":"/professionnels-etablissements-de-soins/gapp-groupe-analyse-pratiques-professionnelles","theme":"Définition et fonctionnement du GAPP, différenciation avec des dispositifs voisins (supervision), bénéfices dans la durée.","weight":3}}