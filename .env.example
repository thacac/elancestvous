# Copy this file to .env (local dev) and configure the matching GitHub Actions
# repository secrets (Settings > Secrets and variables > Actions) for deployment.
# .github/workflows/deploy.yml writes these into .env on the VPS at each deploy.

# --- SMTP (contact form, services/mailer/mailer.ts) ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USR=
SMTP_PWD=

# --- Blog IA hebdomadaire ---
ANTHROPIC_API_KEY=
IMAGE_GEN_API_KEY=
GITHUB_BLOG_PAT=
GITHUB_REPO=thacac/elancestvous
BLOG_CRON_SECRET=

# --- Blog : lancement public (voir lib/featureFlags.ts) ---
# Laisser vide/absent tant que le blog n'est pas prêt à être publié : /blog et
# /blog/[slug] renvoient 404, aucun lien dans la navbar, rien dans le sitemap.
# Ne devient public qu'en mettant explicitement "true".
# Volontairement SANS préfixe NEXT_PUBLIC_ (variable serveur uniquement, lue
# dans app/layout.tsx et transmise en prop au composant client Navbar) :
# changer cette valeur nécessite quand même un nouveau build/déploiement
# (ex. workflow_dispatch sur deploy.yml), pas seulement un redémarrage du
# conteneur.
BLOG_ENABLED=false
